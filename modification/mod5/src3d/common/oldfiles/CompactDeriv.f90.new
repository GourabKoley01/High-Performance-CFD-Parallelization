subroutine CompactDeriv(nvartdg,ntdg, ifper, istart, iend)
  use mod_params
  implicit none

  integer, intent(in)::nvartdg,ntdg,ifper
  integer, intent(in)::istart, iend
  integer :: i,j,ivar

  !print*, 'C6 = ', C6(1), C6(2), C6(3)
  !print*,'7', nvartdg, ntdg, ifper

  do ivar = 1, nvartdg
    do j = 3,ntdg-2
      do i = istart,iend
        atdg(i,j) = C6(1) 
        btdg(i,j) = 1.0d0 
        ctdg(i,j) = C6(1) 
        rhstdg(i,j,ivar) = 0.50d0*C6(2)*(tdg(i, j+1, ivar)-tdg(i,j-1, ivar))+&
          & 0.25*C6(3)*(tdg(i,j+2,ivar)-tdg(i,j-2,ivar))
      enddo
    enddo
  enddo

  if(ifper .eq. 0) then
    call CompactDeriv_bound(nvartdg,ntdg, istart,iend)
  endif

    call ThomasAlg(nvartdg,ntdg, istart, iend)
  !call triper(nvartdg,ntdg,istart,iend)
  !print*, 'ThomasAlg done, j =', j
  contains
    subroutine CompactDeriv_bound(nvartdg,ntdg,istart,iend)
      integer, intent(in)::nvartdg,ntdg
      integer, intent(in)::istart, iend
      do ivar = 1, nvartdg
        do i=istart,iend
              !Boundary Point 1 (1 Sided, 3rd Order Compact Scheme with 3pt Stencil)

          atdg(i,1) = 0.0d0
          btdg(i,1) = 1.0
          ctdg(i,1) = C3B(1)
          rhstdg(i,1,ivar) = C3B(2)*tdg(i,1,ivar) + C3B(3)*tdg(i,2,ivar)+&
            C3B(4)*tdg(i,3,ivar)

              !Boundary Point ntdg (1 Sided, 3rd Order Compact Scheme with 3pt Stencil)
          atdg(i,ntdg) = C3B(1)
          btdg(i,ntdg) = 1.0
          ctdg(i,ntdg) = 0.0d0
          rhstdg(i,ntdg,ivar) = -C3B(2)*tdg(i,ntdg,ivar) - C3B(3)*tdg(i,ntdg-1,ivar)-&
            C3B(4)*tdg(i,ntdg-2,ivar)

              !Boundary Point 2 (Centered, 4th Order Compact Scheme with 3pt Stencil)
          atdg(i,2) = AC4B(1)
          btdg(i,2) = 1.0
          ctdg(i,2) = AC4B(1)
                !dTdg(2,iVars)=0.50d0*C4(2)*(xTdg(3,iVars)-xTdg(1,iVars))
          rhstdg(i,2,ivar) = 0.50d0*AC4B(2)*(-tdg(i,1,ivar) + tdg(i,3,ivar))
          !rhstdg(i,2,ivar) = AC4B(2)*tdg(i,1,ivar) + AC4B(4)*tdg(i,3,ivar)

          atdg(i,ntdg-1) = AC4B(1)
          btdg(i,ntdg-1) = 1.0
          ctdg(i,ntdg-1) = AC4B(1)
                !dTdg(nTdg-1,iVars)=0.50d0*C4(2)*(xTdg(nTdg,iVars)-xTdg(nTdg-2,iVars))
          rhstdg(i,ntdg-1,ivar) = 0.50d0*AC4B(2)*(tdg(i,ntdg,ivar) - tdg(i,ntdg-2,ivar))
          !rhstdg(i,ntdg-1,ivar) = -AC4B(2)*tdg(i,ntdg,ivar) - AC4B(4)*tdg(i,ntdg-2,ivar)
        enddo
      enddo
    end subroutine CompactDeriv_bound
end subroutine CompactDeriv
