subroutine CompactFlux
  use mod_params
  use nvtx
  implicit none

  call nvtxStartRange("xicomp")
  call xicomp
  call nvtxEndRange
  
  call nvtxStartRange("etcomp")
  call etcomp
  call nvtxEndRange
  
  call nvtxStartRange("ztcomp")
  call ztcomp
  call nvtxEndRange

contains
  subroutine xicomp
    integer :: i,j,k,ivar 
    real (kind =8) :: unor, rhou, rhoe
    do j = 2,ny-1
      do k = 2,nz-1
        do i = 1,nx
          unor = xix(i,j,k)*prim(i,j,k,2)+&
            &  xiy(i,j,k)*prim(i,j,k,3) +&
            &  xiz(i,j,k)*prim(i,j,k,4)
          rhou = prim(i,j,k,1)*unor
          rhoe = (1+GAM1I)*prim(i,j,k,5)+0.5*prim(i,j,k,1)*&
            & (prim(i,j,k,2)**2+prim(i,j,k,3)**2+prim(i,j,k,4)**2)
          tdg(k,i,1) = rhou
          tdg(k,i,2) = rhou*prim(i,j,k,2)+xix(i,j,k)*prim(i,j,k,5)
          tdg(k,i,3) = rhou*prim(i,j,k,3)+xiy(i,j,k)*prim(i,j,k,5)
          tdg(k,i,4) = rhou*prim(i,j,k,4)+xiz(i,j,k)*prim(i,j,k,5)
          tdg(k,i,5) = rhoe*unor
        enddo
      enddo
      !print*,'61',j, maxvaivar(tdg), maxvaivar(rhs), unor, rhoe 

      call CompactDeriv(nvars,nx,iper,2,nz-1)

      do ivar=1,nvars
        do k=2,nz-1
          do i=1,nx
            rhs(i,j,k,ivar) = rhs(i,j,k,ivar) + tdg(k,i,ivar)
          enddo
        enddo
      enddo
    enddo
      !print*,'62',j, maxvaivar(tdg), maxvaivar(rhs), unor, rhoe 
  !print*,'6',maxvaivar(tdg)
  !print*,'6',maxvaivar(rhs)
      !print*,'6', nvars, nx, iper 
    return
  end subroutine xicomp

  subroutine etcomp
    integer :: i,j,k,ivar 
    real (kind =8) :: vnor, rhov, rhoe
    do k = 2,nz-1
      do i = 2,nx-1
        do j = 1,ny
          vnor = etax(i,j,k)*prim(i,j,k,2)+&
            &  etay(i,j,k)*prim(i,j,k,3) +&
            &  etaz(i,j,k)*prim(i,j,k,4)
          rhov = prim(i,j,k,1)*vnor
          rhoe = (1+GAM1I)*prim(i,j,k,5)+0.5*prim(i,j,k,1)*&
            & (prim(i,j,k,2)**2+prim(i,j,k,3)**2+prim(i,j,k,4)**2)
          tdg(i,j,1) = rhov
          tdg(i,j,2) = rhov*prim(i,j,k,2)+etax(i,j,k)*prim(i,j,k,5)
          tdg(i,j,3) = rhov*prim(i,j,k,3)+etay(i,j,k)*prim(i,j,k,5)
          tdg(i,j,4) = rhov*prim(i,j,k,4)+etaz(i,j,k)*prim(i,j,k,5)
          tdg(i,j,5) = rhoe*vnor
        enddo
      enddo

      call CompactDeriv(nvars,ny,jper,2,nx-1)

      do ivar=1,nvars
        do i=2,nx-1
          do j=1,ny
            rhs(i,j,k,ivar) = rhs(i,j,k,ivar) + tdg(i,j,ivar)
          enddo
        enddo
      enddo
    enddo
    return
  end subroutine etcomp

  subroutine ztcomp
    integer :: i,j,k,ivar 
    real (kind =8) :: wnor, rhow, rhoe
    do j = 2,ny-1
      do i = 2,nx-1
        do k = 1,nz
          wnor = ztax(i,j,k)*prim(i,j,k,2)+&
            &  ztay(i,j,k)*prim(i,j,k,3) +&
            &  ztaz(i,j,k)*prim(i,j,k,4)
          rhow = prim(i,j,k,1)*wnor
          rhoe = (1+GAM1I)*prim(i,j,k,5)+0.5*prim(i,j,k,1)*&
            & (prim(i,j,k,2)**2+prim(i,j,k,3)**2+prim(i,j,k,4)**2)
          tdg(i,k,1) = rhow
          tdg(i,k,2) = rhow*prim(i,j,k,2)+ztax(i,j,k)*prim(i,j,k,5)
          tdg(i,k,3) = rhow*prim(i,j,k,3)+ztay(i,j,k)*prim(i,j,k,5)
          tdg(i,k,4) = rhow*prim(i,j,k,4)+ztaz(i,j,k)*prim(i,j,k,5)
          tdg(i,k,5) = rhoe*wnor
        enddo
      enddo

      call CompactDeriv(nvars,nz,kper,2,nx-1)

      do ivar=1,nvars
        do i=2,nx-1
          do k=1,nz
            rhs(i,j,k,ivar) = rhs(i,j,k,ivar) + tdg(i,k,ivar)
          enddo
        enddo
      enddo
    enddo
    return
  end subroutine ztcomp
end subroutine CompactFlux
